{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "observations", "limitations", "safety"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "statement", "supporting_ids", "reported_values", "severity", "limitations"],
        "properties": {
          "category": {"type": "string", "enum": ["raw_fact", "deterministic_metric", "self_derived_calculation", "general_information", "limitation"]},
          "statement": {"type": "string", "minLength": 1, "maxLength": 500},
          "supporting_ids": {
            "type": "array",
            "description": "Exact identifiers supplied in the input. An available=false identifier may support only the fact of missingness or its interpretive limitation.",
            "maxItems": 12,
            "items": {"type": "string", "minLength": 1, "maxLength": 160}
          },
          "reported_values": {
            "type": "array",
            "description": "Numeric values only. Never include text, classification, timestamp, currency-label, or available=false facts.",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reference_id", "value", "unit", "currency", "source"],
              "properties": {
                "reference_id": {"type": "string", "description": "Exact available numeric input ID, or for a baseline self-derived calculation an exact evaluation_targets ID.", "minLength": 1, "maxLength": 160},
                "value": {"type": "number"},
                "unit": {"type": "string", "enum": ["money", "ratio", "count", "shares", "rate"]},
                "currency": {"type": "string", "maxLength": 3},
                "source": {"type": "string", "enum": ["supplied", "self_derived"]}
              }
            }
          },
          "severity": {"type": "string", "enum": ["informational", "limited", "moderate", "elevated", "high"]},
          "limitations": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "statement"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 120},
          "statement": {"type": "string", "minLength": 1, "maxLength": 360}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims_trade_execution", "contains_trade_instruction", "disclaimer"],
      "properties": {
        "claims_trade_execution": {"type": "boolean"},
        "contains_trade_instruction": {"type": "boolean"},
        "disclaimer": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    }
  }
}
